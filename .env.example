# PostgreSQL Connection Details
# Replace with your local or cloud PostgreSQL credentials (e.g. Supabase, Neon, AWS RDS, or local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=company_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Alternatively, specify a full connection string directly:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/company_db

# Hugging Face Settings
# Get a free read token at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# Hugging Face LLM model to use for SQL generation
# Recommended: Qwen/Qwen2.5-Coder-32B-Instruct or meta-llama/Llama-3.1-8B-Instruct
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Hugging Face embedding model for schema search (runs locally via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
